networks:
  local-net:
    external: true

services:
  mysql:
    container_name: mysql-server
    restart: unless-stopped
    networks:
      - local-net
    image: registry.cn-beijing.aliyuncs.com/wny311/mysql:8.0
    volumes:
      - mysql-data:/var/lib/mysql
    environment:
      - MYSQL_PASSWORD=zabbix_pwd
      - MYSQL_USER=zabbix
      - MYSQL_DATABASE=zabbix
      - MYSQL_ROOT_PASSWORD=root_pwd
    command:
      - --character-set-server=utf8
      - --collation-server=utf8_bin
      - --default-authentication-plugin=mysql_native_password
    labels:
      - "traefik.enable=false"
  zabbix-server:
    container_name: zabbix-server-mysql
    restart: unless-stopped
    networks:
      - local-net
    image: registry.cn-beijing.aliyuncs.com/wny311/zabbix-server-mysql:alpine-6.4.13
    labels:
      - "traefik.enable=fales"
    environment:
      - DB_SERVER_HOST=mysql-server
      - MYSQL_DATABASE=zabbix
      - MYSQL_USER=zabbix
      - MYSQL_PASSWORD=zabbix_pwd
      - MYSQL_ROOT_PASSWORD=root_pwd
      - ZBX_JAVAGATEWAY=zabbix-java-gateway
    ports:
      - 10051:10051
    depends_on:
      - mysql
  zabbix-web:
    container_name: zabbix-web-nginx-mysql
    restart: unless-stopped
    networks:
      - local-net
    environment:
      - ZBX_SERVER_HOST=zabbix-server-mysql
      - DB_SERVER_HOST=mysql-server
      - MYSQL_DATABASE=zabbix
      - MYSQL_USER=zabbix
      - MYSQL_PASSWORD=zabbix_pwd
      - MYSQL_ROOT_PASSWORD=root_pwd
    image: registry.cn-beijing.aliyuncs.com/wny311/zabbix-web-nginx-mysql:6.4.21-php
    depends_on:
      - mysql
      - zabbix-server
    labels:
      - "traefik.http.routers.zabbix.entrypoints=http"
      - "traefik.http.routers.zabbix.rule=Host(`zabbix.local`)"
      - "traefik.http.routers.zabbix.service=zabbixserver"
      - "traefik.http.services.zabbixserver.loadbalancer.server.port=8080"


volumes:
  mysql-data:
